# copie para .env e ajuste (o .env não vai para o git)

PORT=3000

# banco (Supabase). Valores públicos do projeto; quem protege os dados é o banco.
# Com os dois preenchidos a API usa o banco e as lojas são as integrações criadas no sistema.
SUPABASE_URL=REMOVIDO
SUPABASE_ANON_KEY=REMOVIDO

# modo sem banco (desenvolvimento/testes): lojas autorizadas "Nome:hashSha256", separadas por vírgula. "Nome:hashSha256", separadas por vírgula.
# Gere a chave e a linha com: npm run gerar-chave -- "LojaVerde"
CLIENTES=

# prazo usado quando a loja não envia data_prevista
PRAZO_PADRAO_DIAS=5

# requisições por minuto de cada chave de API
LIMITE_POR_MINUTO=120

# tentativas com chave inválida por minuto de cada IP
FALHAS_POR_MINUTO=10
