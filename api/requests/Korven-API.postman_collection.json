{
  "info": {
    "name": "Korven · API de integração",
    "description": "Requisições de teste da API de integração da Korven. Antes de usar, preencha a variável `token` (formato chave.segredo, criado em Integrações de API no sistema) e confira `baseUrl`. O token não é guardado no repositório. Cada requisição traz testes automáticos com o status esperado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"pedido\")) {",
          "    pm.collectionVariables.set(\"pedido\", \"TESTE-\" + Date.now());",
          "}"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "pedido",
      "value": ""
    },
    {
      "key": "codigo",
      "value": "KV-000000"
    }
  ],
  "item": [
    {
      "name": "1 · Sem token",
      "item": [
        {
          "name": "Saúde da API",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});",
                  "pm.test(\"status ok\", function () { pm.expect(pm.response.json().status).to.eql(\"ok\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/saude",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "saude"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Contrato OpenAPI (JSON)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/docs/openapi.json",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "docs",
                "openapi.json"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "description": "A documentação interativa (Swagger UI) fica em {{baseUrl}}/docs"
          }
        }
      ]
    },
    {
      "name": "2 · Entregas (precisam de token)",
      "item": [
        {
          "name": "Criar entrega",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200 ou 201\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var j = pm.response.json();",
                  "if (j && j.entrega) { pm.collectionVariables.set(\"codigo\", j.entrega.codigo_rastreamento); }",
                  "pm.test(\"devolve entrega, itens e histórico\", function () { pm.expect(j).to.have.keys([\"entrega\", \"itens\", \"historico\"]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/entregas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "entregas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"codigo_pedido_externo\": \"{{pedido}}\",\n  \"nome_destinatario\": \"Marina Souza Almeida\",\n  \"endereco_origem\": \"Porto Alegre/RS\",\n  \"endereco_destino\": \"São Paulo/SP\",\n  \"itens\": [\n    {\n      \"descricao\": \"Monitor 27\\\"\",\n      \"quantidade\": 3,\n      \"peso\": 21\n    },\n    {\n      \"descricao\": \"Teclado\",\n      \"quantidade\": 3,\n      \"peso\": 2.4\n    }\n  ]\n}"
            },
            "description": "201 quando cria; 200 se o mesmo pedido já existir. Guarda o código de rastreio em {{codigo}}."
          }
        },
